diff --git a/rpi3.mk b/rpi3.mk
index 4703f64..f3aa8d9 100644
--- a/rpi3.mk
+++ b/rpi3.mk
@@ -11,10 +11,12 @@ override COMPILE_S_KERNEL  := 64
 # Need to set this before including common.mk
 BR2_TARGET_GENERIC_GETTY_PORT ?= ttyS0
 BR2_ROOTFS_POST_BUILD_SCRIPT ?= "board/raspberrypi3-64/post-build.sh"
+BR2_ROOTFS_OVERLAY ?= "$(ROOT)/build/br-ext/board/rpi3/overlay"
 
 # Network support related packages:
 BR2_PACKAGE_DHCPCD ?= y
 BR2_PACKAGE_ETHTOOL ?= y
+BR2_PACKAGE_CAN_UTILS ?= y
 BR2_PACKAGE_XINETD ?= y
 
 # SSH Packages :
@@ -199,6 +201,9 @@ update_bootfs: tf-a linux u-boot-env
 	@install -v -p --mode=755 $(RPI3_STOCK_FW_PATH)/boot/start_db.elf $(BOOT_PARTITION_FILES)/start_db.elf
 	@install -v -p --mode=755 $(RPI3_STOCK_FW_PATH)/boot/start.elf $(BOOT_PARTITION_FILES)/start.elf
 	@install -v -p --mode=755 $(RPI3_STOCK_FW_PATH)/boot/start_x.elf $(BOOT_PARTITION_FILES)/start_x.elf
+	@mkdir -p --mode=755 $(BOOT_PARTITION_FILES)/overlays
+	@install -v -p --mode=755 $(RPI3_STOCK_FW_PATH)/boot/overlays/seeed-can-fd-hat-v2.dtbo $(BOOT_PARTITION_FILES)/overlays/seeed-can-fd-hat-v2.dtbo
+	@install -v -p --mode=755 $(RPI3_STOCK_FW_PATH)/boot/overlays/mcp251xfd.dtbo $(BOOT_PARTITION_FILES)/overlays/mcp251xfd.dtbo
 
 .PHONY: sdcard-image
 sdcard-image: update_bootfs update_rootfs buildroot
