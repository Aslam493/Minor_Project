diff --git a/br-ext/board/rpi3/optee-reserve.dts b/br-ext/board/rpi3/optee-reserve.dts
new file mode 100644
index 0000000..b12eadb
--- /dev/null
+++ b/br-ext/board/rpi3/optee-reserve.dts
@@ -0,0 +1,24 @@
+/*
+ * N-04 candidate: tell Linux that OP-TEE's secure memory is not its own.
+ * Range = TF-A secure SRAM (0x10000000, 1 MiB) + OP-TEE secure DRAM (0x10100000, 15 MiB)
+ *       = 0x10000000 .. 0x10ffffff (16 MiB). Matches TF-A SEC_SRAM_BASE/SIZE + SEC_DRAM0_BASE/SIZE
+ *       and OP-TEE CFG_TZDRAM_START/SIZE.
+ * 'no-map' also removes it from Linux's own kernel mapping, so a stray kernel access faults
+ * instead of silently writing. It does NOT stop DMA or a deliberate attack (no TZASC on the Pi 3).
+ * The existing /memreserve/ 0x08000000+32 MiB (shared memory) is left untouched.
+ * CANDIDATE ONLY - not installed anywhere.
+ */
+/dts-v1/;
+/plugin/;
+
+/ {
+	fragment@0 {
+		target-path = "/reserved-memory";
+		__overlay__ {
+			optee_secure@10000000 {
+				reg = <0x10000000 0x01000000>;
+				no-map;
+			};
+		};
+	};
+};
diff --git a/br-ext/board/rpi3/overlay/etc/init.d/S12can b/br-ext/board/rpi3/overlay/etc/init.d/S12can
new file mode 100755
index 0000000..9cd6dc1
--- /dev/null
+++ b/br-ext/board/rpi3/overlay/etc/init.d/S12can
@@ -0,0 +1,51 @@
+#!/bin/sh
+#
+# Bring up the CAN-FD shield's SocketCAN interfaces after S11modules has
+# loaded spi_bcm2835/mcp251xfd. Bitrate per STEP11_CAN_HARDWARE_SPEC.md.
+#
+# can1 is allowed to fail here: as of KNOWLEDGE.md Incident 5's third
+# addendum, spi0.1 does not currently detect its MCP251xFD chip (hardware
+# wiring/seating issue), so this must not block boot while that's unresolved.
+
+BITRATE=500000
+
+bring_up() {
+	iface="$1"
+	[ -d "/sys/class/net/$iface" ] || return 1
+	ip link set "$iface" type can bitrate "$BITRATE" && ip link set "$iface" up
+}
+
+start() {
+	printf 'Starting CAN interfaces: '
+	ok=""
+	for iface in can0 can1; do
+		if bring_up "$iface"; then
+			ok="$ok $iface"
+		fi
+	done
+	if [ -n "$ok" ]; then
+		echo "OK ($ok)"
+	else
+		echo "FAIL (no CAN interfaces present)"
+	fi
+	return 0
+}
+
+stop() {
+	printf 'Stopping CAN interfaces: '
+	for iface in can0 can1; do
+		[ -d "/sys/class/net/$iface" ] && ip link set "$iface" down
+	done
+	echo "OK"
+}
+
+case "$1" in
+	start|stop)
+		"$1";;
+	restart|reload)
+		stop
+		start;;
+	*)
+		echo "Usage: $0 {start|stop|restart|reload}"
+		exit 1
+esac
diff --git a/br-ext/board/rpi3/overlay/etc/modules-load.d/can-shield.conf b/br-ext/board/rpi3/overlay/etc/modules-load.d/can-shield.conf
new file mode 100644
index 0000000..19bb7c6
--- /dev/null
+++ b/br-ext/board/rpi3/overlay/etc/modules-load.d/can-shield.conf
@@ -0,0 +1,9 @@
+# Loads the SPI controller (spi_bcm2835) and the CAN controller driver
+# (mcp251xfd) at boot. Neither auto-loads on its own: spi_bcm2835 is
+# built as a module (CONFIG_SPI_BCM2835=m) and nothing else in this
+# project ever needed SPI before the CAN shield, so it was never
+# triggered. Without this, can0/can1 never appear even though the
+# device tree and driver are both otherwise correctly set up.
+# See KNOWLEDGE.md Incident 5, second addendum.
+spi_bcm2835
+mcp251xfd
