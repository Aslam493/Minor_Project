diff --git a/kconfigs/rpi3.conf b/kconfigs/rpi3.conf
index 07554cf..72849e6 100644
--- a/kconfigs/rpi3.conf
+++ b/kconfigs/rpi3.conf
@@ -1,2 +1,3 @@
 CONFIG_TEE=y
 CONFIG_OPTEE=y
+CONFIG_MODULE_DECOMPRESS=y
diff --git a/rpi3.mk b/rpi3.mk
index 4703f64..51943d4 100644
--- a/rpi3.mk
+++ b/rpi3.mk
@@ -11,10 +11,12 @@ override COMPILE_S_KERNEL  := 64
 # Need to set this before including common.mk
 BR2_TARGET_GENERIC_GETTY_PORT ?= ttyS0
 BR2_ROOTFS_POST_BUILD_SCRIPT ?= "board/raspberrypi3-64/post-build.sh"
+BR2_ROOTFS_OVERLAY ?= "$(ROOT)/build/br-ext/board/rpi3/overlay"
 
 # Network support related packages:
 BR2_PACKAGE_DHCPCD ?= y
 BR2_PACKAGE_ETHTOOL ?= y
+BR2_PACKAGE_CAN_UTILS ?= y
 BR2_PACKAGE_XINETD ?= y
 
 # SSH Packages :
@@ -182,8 +184,17 @@ update_rootfs: linux
 
 update_bootfs: tf-a linux u-boot-env
 	@mkdir -p --mode=755 $(BOOT_PARTITION_FILES)
-	@install -v -p --mode=755 $(LINUX_DTB_RPI3_B) $(BOOT_PARTITION_FILES)/bcm2710-rpi-3-b.dtb
-	@install -v -p --mode=755 $(LINUX_DTB_RPI3_BPLUS) $(BOOT_PARTITION_FILES)/bcm2710-rpi-3-b-plus.dtb
+	@# U-Boot loads the .dtb straight off the FAT boot partition
+	@# (uboot.env.txt: load_fdt = fatload mmc 0:1 ...) -- it never sees
+	@# whatever the GPU firmware does with dtoverlay=/device_tree_address,
+	@# so any overlay has to be baked into the shipped .dtb at build time
+	@# instead (see KNOWLEDGE.md Incident 5).
+	@$(LINUX_PATH)/scripts/dtc/fdtoverlay -i $(LINUX_DTB_RPI3_B) \
+		-o $(BOOT_PARTITION_FILES)/bcm2710-rpi-3-b.dtb \
+		$(RPI3_STOCK_FW_PATH)/boot/overlays/seeed-can-fd-hat-v2-nortc.dtbo
+	@$(LINUX_PATH)/scripts/dtc/fdtoverlay -i $(LINUX_DTB_RPI3_BPLUS) \
+		-o $(BOOT_PARTITION_FILES)/bcm2710-rpi-3-b-plus.dtb \
+		$(RPI3_STOCK_FW_PATH)/boot/overlays/seeed-can-fd-hat-v2-nortc.dtbo
 	@install -v -p --mode=755 $(RPI3_BOOT_CONFIG) $(BOOT_PARTITION_FILES)/config.txt
 	@install -v -p --mode=755 $(LINUX_IMAGE) $(BOOT_PARTITION_FILES)/kernel8.img
 	@install -v -p --mode=755 $(TF_A_BOOT) $(BOOT_PARTITION_FILES)/armstub8.bin
