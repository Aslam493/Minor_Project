+/* Brings the CAN chip up from scratch entirely from Secure World - see
+ * the CAN0_CAPTURED_* comment above for where these values come from.
+ * Idempotent: safe to call before every transmit, matching this file's
+ * existing "don't trust driver_init()-time state, redo cheap setup
+ * explicitly" discipline (see rpi3_can_fiq_arm_gpio()).
+ */
+static bool can0_secure_init(void)
+{
+	if (!can0_request_mode(MCP251XFD_REG_CON_MODE_CONFIG))
+		return false;
+
+	if (!mcp251xfd_write32(MCP251XFD_REG_NBTCFG, CAN0_CAPTURED_NBTCFG))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_REG_TDC, CAN0_CAPTURED_TDC))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_FIFOCON(0), CAN0_CAPTURED_TXQCON))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_FIFOCON(CAN0_RX_FIFO_INDEX),
+			       CAN0_CAPTURED_RXFIFOCON))
+		return false;
+
+	/* Accept-all filter 0, routed to the RX FIFO above - without this,
+	 * the chip has nowhere to route a matching frame and drops it
+	 * (IVMIF) instead of ever setting RXIF. FLTOBJ/FLTMASK both zero
+	 * means "don't care" for every ID bit (matches Linux's own
+	 * approach, which relies on their power-on-reset value rather than
+	 * writing them explicitly - written here anyway since this code
+	 * cannot assume the chip is at a fresh power-on reset).
+	 */
+	if (!mcp251xfd_write32(MCP251XFD_REG_FLTOBJ0, 0))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_REG_FLTMASK0, 0))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_REG_FLTCON0,
+			       MCP251XFD_REG_FLTCON0_FLTEN0 | CAN0_RX_FIFO_INDEX))
+		return false;
+
+	/* Mode transitions (e.g. into loopback below) set MODIF - and were
+	 * empirically observed to also leave IVMIF set (--rxif-debug showed
+	 * INT=0x00028008, both flags, RXIF never set, identical across
+	 * multiple otherwise-different transmit attempts - see
+	 * KNOWLEDGE.md's ninth addendum). Enable RXIE only *after* the mode
+	 * transition and only after explicitly clearing whatever the
+	 * transition itself latched, so a genuine later RXIF isn't
+	 * ambiguous against stale transition flags.
+	 */
+	if (!can0_request_mode(MCP251XFD_REG_CON_MODE_INT_LOOPBACK))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_REG_INT, 0))
+		return false;
+	/* BDIAG1 is sticky (only cleared by an explicit write, same as
+	 * Linux's mcp251xfd_handle_ivmif()) - clear it here so a later
+	 * --bdiag1-debug read after a transmit can only reflect *this*
+	 * attempt's fault, never one latched from a previous run.
+	 */
+	if (!mcp251xfd_write32(MCP251XFD_REG_BDIAG1, 0))
+		return false;
+	if (!mcp251xfd_write32(MCP251XFD_REG_INT, MCP251XFD_REG_INT_RXIE))
+		return false;
+
+	/* Step 4.3B: explicitly enable the Time Base Counter. Exact value
+	 * written: 0x00010000 (TBCEN=1, bit 16; TBCPRE[9:0]=0, i.e. finest
+	 * resolution/1 clock per tick - matches Linux's own
+	 * mcp251xfd_chip_timestamp_init(), which this project never invokes
+	 * since it requires "ip link up", never done here). Idempotent, same
+	 * as every other write in this function - safe to call on every
+	 * transmit. Read back and verify the bit actually took hold, matching
+	 * this file's existing "verify, don't just hope" discipline (see
+	 * can0_request_mode()'s own OPMOD poll above).
+	 */
+	{
+		uint32_t tscon_before = 0;
+		uint32_t tscon_readback = 0;
+		bool tbc_was_running;
+
+		/* Step 4.3C: read CiTSCON *before* writing it, so a call that
+		 * finds TBCEN already set (every call after the first this
+		 * boot, per the Step 4.3B hardware finding referenced above)
+		 * does not bump can0_tbc_epoch - only a genuine 0->1
+		 * transition does, since only that transition actually
+		 * resets/(re)starts CiTBC.
+		 */
+		if (!mcp251xfd_read32(MCP251XFD_REG_TSCON, &tscon_before))
+			return false;
+		tbc_was_running = (tscon_before & MCP251XFD_REG_TSCON_TBCEN) != 0;
+
+		if (!mcp251xfd_write32(MCP251XFD_REG_TSCON, MCP251XFD_REG_TSCON_TBCEN))
+			return false;
+		if (!mcp251xfd_read32(MCP251XFD_REG_TSCON, &tscon_readback))
+			return false;
+		if (!(tscon_readback & MCP251XFD_REG_TSCON_TBCEN))
+			return false;
+
+		if (!tbc_was_running)
+			can0_tbc_epoch++;
+	}
+	return true;
+}
+
+/* Step 4.4C: computes the canonical HMAC-SHA256 tag over
+ * CAN_ID || COUNTER || APPLICATION_PAYLOAD (12 bytes, all little-endian -
+ * same byte order as every other multi-byte field in this file). Used both
+ * by can0_secure_transmit() (to construct a tag to send) and
+ * secure_can_validate_frame() (to recompute the expected tag to compare
+ * against a received one) - one implementation, not duplicated. Defined
+ * here (before its first use in can0_secure_transmit() below) rather than
+ * near secure_can_validate_frame(), matching this file's existing
+ * define-before-use style for static helpers.
+ *
+ * Uses the pre-allocated can0_hmac_ctx (see its own comment for the
+ * allocate-once rationale and the documented residual per-call allocator
+ * touch inside crypto_mac_init()/crypto_mac_final()). Does NOT call
+ * crypto_mac_alloc_ctx()/crypto_mac_free_ctx() - only init/update/final,
+ * reusing the same context object every time.
+ */
+static bool can0_compute_hmac(uint32_t id, uint32_t counter,
+			      const uint8_t app_payload[CAN0_FD_APP_PAYLOAD_LEN],
+			      uint8_t tag_out[CAN0_FD_HMAC_TAG_LEN])
+{
+	uint8_t msg[4 + CAN0_FD_COUNTER_LEN + CAN0_FD_APP_PAYLOAD_LEN];
+
+	if (!can0_hmac_ctx)
+		return false;
+
+	msg[0] = (uint8_t)id;
+	msg[1] = (uint8_t)(id >> 8);
+	msg[2] = (uint8_t)(id >> 16);
+	msg[3] = (uint8_t)(id >> 24);
+	msg[4] = (uint8_t)counter;
+	msg[5] = (uint8_t)(counter >> 8);
+	msg[6] = (uint8_t)(counter >> 16);
+	msg[7] = (uint8_t)(counter >> 24);
+	memcpy(&msg[8], app_payload, CAN0_FD_APP_PAYLOAD_LEN);
+
+	if (crypto_mac_init(can0_hmac_ctx, can0_hmac_key, CAN0_HMAC_KEY_LEN))
+		return false;
+	if (crypto_mac_update(can0_hmac_ctx, msg, sizeof(msg)))
+		return false;
+	if (crypto_mac_final(can0_hmac_ctx, tag_out, CAN0_FD_HMAC_TAG_LEN))
+		return false;
+
+	return true;
+}
+
+/* Constructs and transmits a test frame directly via SPI, entirely from
+ * Secure World - needed because once Linux's binding to can0 is removed
+ * there is no SocketCAN interface left for anything else to send with.
+ * Loopback mode (set by can0_secure_init()) means the chip echoes this
+ * back to its own RX FIFO without needing a real second bus node,
+ * exactly like the existing `ip link ... loopback on` test flow this
+ * replaces.
+ */
+/* Routes peripheral FIQs to whichever core is actually primary
+ * (RPI3_PRIMARY_CORE_POS, platform_config.h), instead of the magic-literal
+ * "always core 0" this project had drifted into at THREE separate call
+ * sites (this file's rpi3_can_fiq_init() and arm_fiq_control(), plus
+ * core/pta/rpi3_can_spi_poc.c's ARM_FIQ command) - found in a full sweep
+ * after tonight's RPI_PRIMARY_CPU change, none of the three had been
+ * updated to match. Exported (not static) so the PTA file can call it too,
+ * replacing its own independent copy of the same three lines.
+ */
+void rpi3_route_fiq_to_primary_core(vaddr_t local)
+{
+	uint32_t routing = io_read32(local + ARM_LOCAL_GPU_INT_ROUTING_OFFSET);
+
+	routing &= ~ARM_LOCAL_GPU_INT_ROUTING_FIQ_MASK;
+	routing |= (RPI3_PRIMARY_CORE_POS << ARM_LOCAL_GPU_INT_ROUTING_FIQ_SHIFT) &
+		   ARM_LOCAL_GPU_INT_ROUTING_FIQ_MASK;
+	io_write32(local + ARM_LOCAL_GPU_INT_ROUTING_OFFSET, routing);
+}
+
+/* Arms FIQ routing for this platform's one FIQ source (see the
+ * VC_INTC and ARM_LOCAL register comments in platform_config.h).
+ * Deliberately separate from the ARM_FIQ PTA command's copy of this same
+ * logic: this one gets called from inside can0_secure_transmit(), timed
+ * to happen only after the chip is fully reinitialized and the message
+ * is already staged - arming any earlier risks a stray interrupt
+ * condition from the mode-transition sequence itself preempting our own
+ * in-flight SPI transaction, corrupting it exactly like Linux's
+ * transactions were corrupted before this file existed (see
+ * KNOWLEDGE.md's ninth addendum). This is why plain "arm, then transmit"
+ * as two separate PTA calls does not work reliably for this specific
+ * flow.
+ */
+static void arm_fiq_control(void)
+{
+	vaddr_t local = arm_local_base();
+	vaddr_t intc = vc_intc_base();
+
+	rpi3_route_fiq_to_primary_core(local);
+	rpi3_can_fiq_arm_gpio();
+	io_write32(intc + VC_INTC_FIQ_CONTROL_OFFSET,
+		  VC_INTC_FIQ_ENABLE | CAN0_GPIO_FIQ_SOURCE);
+}
+
+/* Step 4.4C: data[8] keeps its Step 4.2 meaning exactly (data[0..3]=counter
+ * little-endian, data[4..7]=application payload) - the external interface
+ * (this function, rpi3_can_fiq_transmit(), the PTA command, the CLI's
+ * --transmit-secure) is unchanged. Only the internal construction changes:
+ * this now computes the HMAC itself and writes the full CAN-FD object
+ * (counter+payload+tag+padding) instead of the old plain 8-byte object.
+ */
+static bool can0_secure_transmit(uint32_t id, const uint8_t data[8])
+{
+	uint8_t ua[4];
+	uint32_t addr;
+	uint32_t counter;
+	uint8_t payload[CAN0_FD_PLSIZE_BYTES] = { 0 }; /* zero-initialized: bytes
+							 * 40..47 stay 0 (explicit
+							 * padding) unless written */
+	uint32_t flags = CAN0_FD_DLC | MCP251XFD_OBJ_FLAGS_FDF; /* DLC=14 (48
+					bytes) in bits[3:0], FDF=1 (CAN-FD),
+					BRS=0 (deliberately not set - see
+					CAN0_FD_DLC's own comment: avoids
+					needing an unverified data-phase bit
+					timing register), IDE=0, RTR=0 */
+	uint32_t i;
+
+	/* Fully initialize and stage the message with FIQ_CONTROL still
+	 * disarmed - see arm_fiq_control()'s comment for why order matters
+	 * here.
+	 */
+	io_write32(vc_intc_base() + VC_INTC_FIQ_CONTROL_OFFSET, 0);
+
+	can0_last_tx_fail_point = 0;
+
+	if (!can0_secure_init()) {
+		can0_last_tx_fail_point = 1;
+		return false;
+	}
+
+	counter = (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+		  ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+
+	/* payload[0..7] = counter + application payload, verbatim - same
+	 * bytes as the old 8-byte format occupied.
+	 */
+	memcpy(&payload[0], data, CAN0_FD_COUNTER_LEN + CAN0_FD_APP_PAYLOAD_LEN);
+
+	/* payload[8..39] = HMAC-SHA256 over CAN_ID||counter||app_payload
+	 * (the approved canonical input - see can0_compute_hmac()'s comment).
+	 * payload[40..47] is left at 0 from the initializer above - explicit
+	 * zero padding, not covered by HMAC.
+	 */
+	if (!can0_compute_hmac(id, counter, &data[CAN0_FD_COUNTER_LEN],
+			       &payload[CAN0_FD_COUNTER_LEN + CAN0_FD_APP_PAYLOAD_LEN])) {
+		can0_last_tx_fail_point = 2;
+		return false;
+	}
+
+	if (!mcp251xfd_read(MCP251XFD_FIFOUA(0), ua, sizeof(ua))) {
+		can0_last_tx_fail_point = 3;
+		return false;
+	}
+	addr = CAN0_MSGRAM_BASE + ((uint32_t)ua[0] | ((uint32_t)ua[1] << 8) |
+		((uint32_t)ua[2] << 16) | ((uint32_t)ua[3] << 24));
+
+	if (!mcp251xfd_write32((uint16_t)addr, id)) {
+		can0_last_tx_fail_point = 4;
+		return false;
+	}
+	if (!mcp251xfd_write32((uint16_t)(addr + 4), flags)) {
+		can0_last_tx_fail_point = 5;
+		return false;
+	}
+
+	/* TX objects are id(4)+flags(4)+data(48) = 56 bytes at PLSIZE_48 - NO
+	 * timestamp field (that only exists on RX objects; the chip fills it
+	 * in on receive) - same fact as the old 8-byte format, just a bigger
+	 * data region now. Written as CAN0_FD_PLSIZE_BYTES/4 = 12 4-byte
+	 * words, a small fixed-count bounded loop, same discipline as every
+	 * other loop in this file.
+	 */
+	for (i = 0; i < CAN0_FD_PLSIZE_BYTES / 4U; i++) {
+		uint32_t word = (uint32_t)payload[4U * i] |
+			((uint32_t)payload[4U * i + 1] << 8) |
+			((uint32_t)payload[4U * i + 2] << 16) |
+			((uint32_t)payload[4U * i + 3] << 24);
+
+		if (!mcp251xfd_write32((uint16_t)(addr + 8U + 4U * i), word)) {
+			can0_last_tx_fail_point = 6U + i; /* 6..17 */
+			return false;
+		}
+	}
+
+	{
+		uint32_t fifocon;
+		bool ok;
+
+		/* Read-modify-write: a blind overwrite here would wipe out
+		 * TXEN/PLSIZE/FSIZE etc. that CAN0_CAPTURED_TXQCON set,
+		 * leaving only the strobe bits - the same mistake fixed
+		 * below in read_pending_rx_frame()'s UINC write.
+		 */
+		if (!mcp251xfd_read32(MCP251XFD_FIFOCON(0), &fifocon)) {
+			can0_last_tx_fail_point = 18;
+			return false;
+		}
+		fifocon |= MCP251XFD_FIFOCON_UINC | MCP251XFD_FIFOCON_TXREQ;
+
+		/* Arm only now - everything above this point runs unarmed,
+		 * so nothing here can preempt itself.
+		 */
+		arm_fiq_control();
+
+		ok = mcp251xfd_write32(MCP251XFD_FIFOCON(0), fifocon);
+		if (!ok)
+			can0_last_tx_fail_point = 19;
+		return ok;
+	}
+}
