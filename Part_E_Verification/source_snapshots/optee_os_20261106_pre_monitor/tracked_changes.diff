+	con |= mode << MCP251XFD_REG_CON_REQOP_SHIFT;
+	if (!mcp251xfd_write32(MCP251XFD_REG_CON, con))
+		return false;
+
+	for (i = 0; i < SPI_POLL_TIMEOUT_LOOPS; i++) {
+		if (!mcp251xfd_read32(MCP251XFD_REG_CON, &con))
+			return false;
+		opmod = (con >> MCP251XFD_REG_CON_OPMOD_SHIFT) &
+			MCP251XFD_REG_CON_MODE_MASK;
+		if (opmod == mode)
+			return true;
+	}
+	return false;
+}
