+/* Step 4.3C: freshness check. packet_timestamp/packet_epoch come from
+ * can0_last_frame_timestamp/can0_last_frame_tbc_epoch, captured at the same
+ * moment read_pending_rx_frame() read the RX object - not re-read here.
+ * live_tbc is read fresh, right now, via a direct SPI read of CiTBC.
+ *
+ * age uses unsigned 32-bit modular subtraction, which is the wrap-safe way
+ * to compare a free-running counter's "now" against an earlier sample, as
+ * long as the true elapsed time stays under half the 32-bit range (see
+ * CAN0_TIMESTAMP_FRESHNESS_TICKS's comment for the wraparound caveat).
+ */
+static bool can0_check_timestamp_fresh(uint32_t packet_timestamp,
+					uint32_t packet_epoch)
+{
+	uint32_t live_tbc = 0;
+	uint32_t age;
+
+	if (packet_epoch != can0_tbc_epoch)
+		return false;
+
+	if (!mcp251xfd_read32(MCP251XFD_REG_TBC, &live_tbc))
+		return false;
+
+	age = live_tbc - packet_timestamp;
+	return age <= CAN0_TIMESTAMP_FRESHNESS_TICKS;
+}
