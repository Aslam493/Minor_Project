+/* Step 4.2/4.3/4.4C/4.4D validation. STEP 4.4D: no longer called from FIQ
+ * context - called only from rpi3_can_fiq_process_pending_frame() below,
+ * itself only ever called from rpi3_can_server_loop()'s ordinary Core 1
+ * execution (rpi3_can_server.c). id/data are the frame
+ * rpi3_can_fiq_process_pending_frame() has just claimed from the
+ * can0_frame_state handoff (CAN0_FD_MEANINGFUL_LEN bytes) - read_pending_rx_frame()
+ * (FIQ context) captured them earlier; nothing here re-reads the chip. This
+ * is exactly the function whose HMAC step previously ran inside the FIQ and
+ * hung the board - see this file's top-of-file comment and can0_hmac_ctx's
+ * own comment for what changed and what is/isn't fixed by that change.
+ *
+ * Validation order (Step 4.4C adds the HMAC check between freshness and
+ * final accept; the CAN ID, replay, and freshness checks themselves are
+ * unchanged from Step 4.2/4.3):
+ *   1. extract counter (data[0..3], little-endian) and note the id
+ *   2. check CAN ID first
+ *   3. check counter strictly-monotonic against secure_last_counter
+ *   4. check the captured frame's timestamp is fresh (age within policy)
+ *   5. recompute the HMAC over CAN_ID||counter||data[4..7] and compare,
+ *      constant-time, against the received tag at data[8..39]
+ *   6. only on ALL FOUR passing: accept and advance secure_last_counter
+ *   7. on any failing: drop, secure_last_counter is left untouched
+ *
+ * secure_last_counter is deliberately NOT advanced until step 5 also
+ * passes: a replay-valid, fresh, but HMAC-invalid frame must not consume
+ * that counter value, otherwise a genuine later frame reusing it would be
+ * wrongly rejected as a replay.
+ */
+static void secure_can_validate_frame(uint32_t id,
+				      const uint8_t data[CAN0_FD_MEANINGFUL_LEN])
+{
+	uint32_t counter = (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+			   ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+	const uint8_t *app_payload = &data[CAN0_FD_COUNTER_LEN];
+	const uint8_t *received_tag = &data[CAN0_FD_COUNTER_LEN + CAN0_FD_APP_PAYLOAD_LEN];
+	uint8_t expected_tag[CAN0_FD_HMAC_TAG_LEN];
+
+	can0_last_validation_id = id;
+	can0_last_validation_counter = counter;
+
+	if (id != SECURE_ALLOWED_CAN_ID) {
+		can0_last_validation_status = CAN0_VALIDATION_INVALID_ID;
+		return;
+	}
+
+	/* Strictly monotonic: counter must be greater than the last ACCEPTED
+	 * counter. Equal or lower is replay/out-of-order - reject without
+	 * touching secure_last_counter.
+	 */
+	if (counter <= secure_last_counter) {
+		can0_last_validation_status = CAN0_VALIDATION_REPLAY;
+		return;
+	}
+
+	/* Counter/replay passed - do NOT commit secure_last_counter yet,
+	 * the freshness and HMAC checks can still reject this frame.
+	 */
+	if (!can0_check_timestamp_fresh(can0_last_frame_timestamp,
+					 can0_last_frame_tbc_epoch)) {
+		can0_last_validation_status = CAN0_VALIDATION_STALE;
+		return;
+	}
+
+	/* HMAC over CAN_ID||counter||application_payload only - padding
+	 * bytes 40..47 are never read here, matching the approved design
+	 * (Step 4.4B/4.4C: padding is not part of the authenticated input).
+	 */
+	if (!can0_compute_hmac(id, counter, app_payload, expected_tag) ||
+	    consttime_memcmp(expected_tag, received_tag,
+			     CAN0_FD_HMAC_TAG_LEN) != 0) {
+		can0_last_validation_status = CAN0_VALIDATION_HMAC_FAIL;
+		return;
+	}
+
+	secure_last_counter = counter;
+	can0_last_validation_status = CAN0_VALIDATION_ACCEPTED;
+}
