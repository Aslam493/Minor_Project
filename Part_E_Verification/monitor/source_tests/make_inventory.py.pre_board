#!/usr/bin/env python3
"""Generates ../COMPONENT_2_2_INVENTORY.md. The 53 IDs, requirement texts and kinds are parsed from the ORIGINAL inventory table in
MONITOR_STATE_DESIGN.md (section 4j); the evidence mapping below is hand-written. The script refuses to run if the mapping and the original IDs differ."""
import re, sys, collections
D = '../MONITOR_STATE_DESIGN.md'
txt = open(D).read()
sec = txt.split('### Check inventory (53 checks)')[1].split('Counts: host-side')[0]
orig = collections.OrderedDict()
for l in sec.splitlines():
    m = re.match(r'\| ([A-Z][0-9]+) \| (.*) \| (host-side logic test|static / review / build / disassembly|on-board|deferred to interface subcomponent) \| NOT RUN \|$', l)
    if m: orig[m.group(1)] = (m.group(2), m.group(3))
assert len(orig) == 53, len(orig)
H = 'harness.c'; R = 'run_closure_20261107.txt'; ST = 'static_closure_20261107.txt'; MU = 'mutation_closure_20261107.txt'
M = 'rpi3_can_monitor.c'; G = 'rpi3_can_monitor_pta.c'
HOSTLIM = "Host test with a mock lock, mock timer and mock bindings; real monitor source, not real hardware."
rows = {}
def r(i, loc, test, ev, res, lim): rows[i] = (loc, test, ev, res, lim)
# ---------------- host-side logic tests (25)
r('V6', M+': rpi3_mon_acquire', H+':107 "X2/X6/V6 held lock: BUSY within the budget, state restored, one increment"', R+' (406/0); '+MU+': mutants "no increment on exhaustion", "double increment on exhaustion" caught', 'PASS', HOSTLIM)
r('V7', M+': rpi3_mon_acquire', H+':104 "X1/V7 free lock: acquired on the first attempt, no timeout increment"', R+'; mutant "counter incremented on success" caught', 'PASS', HOSTLIM)
r('V9', M+': MON_PLAT_INC32 use; consumer rpi3_mon_core1_attempt', H+':125 "V9 pta_lock_timeouts wraps modulo 2^32..." and :482 "V10/S2 ... exact total and wrap"', R, 'PASS', HOSTLIM+" Wrap is reached by presetting the counter near 0xFFFFFFF0, not by 2^32 real increments.")
r('V10', M+': rpi3_mon_core1_attempt', H+':482 "V10/S2 timeouts are observed only after a successful lock, never consumed on a failure"; :473 "Y2"', R+'; mutants "Core 1 timeout delta not relative", "Core 1 never records what it observed" caught', 'PASS', HOSTLIM+" The event rate limit is covered separately by Q5 (:165).")
r('V11', M+': rpi3_mon_mac_enter/leave; core/pta/rpi3_can_spi_poc.c: static assert', H+':129 "V11 mac_pta guard"; :554 "STRESS HMAC commands 17 and 22 from 3 contexts"; concurrent_negative_closure_20261107.txt', R+'; mutants "mac guard never released in command 17", "mac guard not used in command 17/22" caught; negative compile test: adding TA_FLAG_CONCURRENT fails with "static assertion failed"', 'PASS', HOSTLIM+" Build-failure half checked by compiling a temporary copy outside the tree with the ON build's own compile command.")
r('V12', M+': rpi3_mon_evaluate, rpi3_mon_traffic_refresh', H+':186 "V12/Z5 exactly-once traffic timeout and recovery, from both contexts"; :196 "EV6/V12 heartbeat: k misses after the grace period, never-started, no catch-up burst, no wrap"', R+'; mutants "traffic timeout not exactly once", "heartbeat miss counted on every evaluation" caught', 'PASS', HOSTLIM+" Interleaving is simulated by calling evaluate from both contexts at chosen times plus two stress tests; not exhaustive.")
r('W3', M+': rpi3_mon_init, rpi3_mon_cmd17..23 (init_ok test); '+G, H+':78 "INIT-3 every init failure keeps the boot going and the monitor unavailable"; :429 "DS4 monitor init failure: 17 to 23 return BAD_STATE"', R+'; mutants "init failure fails the OS boot", "init failure still publishes init_ok" caught', 'PASS', HOSTLIM)
r('W6', M+': rpi3_mon_acquire, rpi3_mon_health_fill', H+':107 "X2" and :331 "N3/N4/N8/HP2 command 20: short buffer, BUSY, precedence, health fill rule" (simulated holder via ext_hold)', R, 'PASS', HOSTLIM+" The holder is simulated; a stalled real Core 1 is not exercised.")
r('X1', M+': rpi3_mon_acquire', H+':104 "X1/V7"', R, 'PASS', HOSTLIM)
r('X2', M+': rpi3_mon_acquire', H+':107 "X2/X6/V6"', R+'; mutants "fresh budget per acquisition", "no attempt cap", "old fail-open test" caught', 'PASS', HOSTLIM+" The 1 ms budget is in mock ticks.")
r('X3', M+': rpi3_mon_acquire (attempt cap)', H+':110 "X3/X4 frozen timer exits by the cap"', R+'; mutant "no attempt cap" caught', 'PASS', HOSTLIM)
r('X4', M+': rpi3_mon_acquire (backward timer)', H+':110 "X3/X4 ... backward timer exits at once"; :119 "X6/X4b"', R+'; mutant "no now < t0 term" SURVIVED and was analysed as equivalent (unsigned wrap already fails closed); "old fail-open test" caught', 'PASS', HOSTLIM+" The explicit now<t0 test is redundant with the unsigned wrap, so the backward-timer path is exercised but the term itself cannot be killed by a test.")
r('X5', M+': rpi3_mon_cmd22 (two holds), rpi3_mon_acquire', H+':113 "X5 two acquisitions share one budget; time between them is not counted"; :375 "N22-6/7"', R+'; mutant "fresh budget per acquisition" caught', 'PASS', HOSTLIM)
r('X6', M+': rpi3_mon_acquire, rpi3_mon_release', H+':107 "X2/X6/V6"; :119 "X6/X4b order control"', R+'; mutants "exceptions not restored after exhaustion", "unmask before unlock on release" caught', 'PASS', HOSTLIM+" Mock records mask/unmask and spinlock count on every exit path tested.")
r('X7', M+': rpi3_mon_cmd17..20 BUSY branches', H+':123 "X7 BUSY path touches no lock-protected or G7 state"; :253 "C17-6"', R, 'PASS', HOSTLIM)
r('Y1', M+': rpi3_mon_core1_attempt; '+'rpi3_can_monitor.h: rpi3_mon_core1_pass', H+':468 "Y1/Y9 one non-spinning attempt per 256 passes; no timer read on the other passes"', R+'; mutants "Core 1 cadence 128", "Core 1 attempts on every pass" caught', 'PASS', HOSTLIM)
r('Y2', M+': rpi3_mon_core1_attempt (failure branch)', H+':473 "Y2 a failed attempt changes only G7"', R+'; mutant "Core 1 failure path writes protected state" caught', 'PASS', HOSTLIM)
r('Y3', M+': rpi3_mon_core1_attempt', H+':475 "Y3/Y4/Y5 starvation: K consecutive failures..."', R+'; mutants "starvation threshold 1" (header and .c) caught', 'PASS', HOSTLIM)
r('Y4', M+': rpi3_mon_core1_attempt', H+':475 "Y3/Y4/Y5"', R+'; mutants "Core 1 logs MON_STARVED below K", "Core 1 resets skip_total" caught', 'PASS', HOSTLIM)
r('Y5', M+': rpi3_mon_core1_attempt', H+':475 "Y3/Y4/Y5 ... a stuck lock gives no event"', R, 'PASS', HOSTLIM)
r('Z1', M+': rpi3_mon_l() accessor; the only direct rpi3_mon.l. use is in rpi3_mon_init', H+':127 "Z1 lock-protected state is flagged when touched without the lock"', R+'; inventory_probes_closure_20261107.txt (one direct access, in init before init_ok)', 'PASS', HOSTLIM+" The check works through the accessor; protection against a future direct rpi3_mon.l. access is by review only.")
r('Z3', M+': rpi3_mon_cmd17 (copy-in), rpi3_mon_cmd18/20 (copy-out)', H+':258 "C17-7 the caller buffer is copied before the lock and the HMAC runs with the lock released"; :275 "Q1/Q4 ... copy-out after the unlock"; :308 "N1/N5/N7/HP5"', R+'; mutants "command 18 copies to the caller before the unlock", "command 20 lock-free fields read before the unlock" caught; hold_memcpy_closure_20261107.txt: cmd18/cmd20 memcpy outside any hold', 'PASS', HOSTLIM+" Object-code flow check agrees for cmd18 and cmd20; the former memcpy inside the cmd17 hold (H1) was fixed and re-checked.")
r('Z4', M+': BUSY branches of cmd17..20', H+':123 "X7"; :253 "C17-6"; :331 "N3/N4/N8/HP2"', R, 'PASS', HOSTLIM)
r('Z5', M+': rpi3_mon_evaluate called once per command in cmd17..23', H+':186 "V12/Z5"; :217 to :403 command tests (C17-*, Q1/Q4, ACK, N*, L21-*, N22, N23), each calls the command once and checks the transitions', R, 'PASS', HOSTLIM+" Once-per-command is shown for the commands tested; no counter of evaluate calls is asserted in every command.")
r('Z6', M+': rpi3_mon_hmac callers (cmd17, cmd22)', H+':258 "C17-7 the caller buffer is copied before the lock and the HMAC runs with the lock released"; :129 "V11"; :554 STRESS HMAC', R+'; hold_memcpy_closure_20261107.txt: both rpi3_mon_hmac calls outside any hold; static F13/F27 checks', 'PASS', HOSTLIM+" Mock records HMAC-in-hold; the object-code flow check is independent evidence.")
# ---------------- static / review / build / disassembly (18)
r('V1', 'rpi3_can_monitor.h: struct rpi3_mon_state (timeouts member), _Static_assert V1', H+':93 "V1 runtime layout"; static_checks V1/N5/EV1/TM1/Q2', ST+'; build final_on.log exit 0 (static asserts compile)', 'PASS', "Alignment shown by compile-time asserts and a runtime layout test on the host (x86-64 or the host compiler's layout), not by reading the AArch64 symbol addresses.")
r('V3', M+': every reference to rpi3_mon_pta_lock_timeouts', 'static_checks "V3/V8 pta_lock_timeouts is touched only by MON_PLAT_INC32 and rpi3_mon_load_u32"', ST, 'PASS', "Source pattern check on comment-stripped text; the load accessor is a relaxed atomic load (__atomic_load_n).")
r('V4', 'rpi3_can_monitor_plat.h: MON_PLAT_INC32 -> atomic_inc32; '+M+': rpi3_mon_acquire', 'inventory_probes_closure_20261107.txt (machine code of atomic_inc32; only increment site); static_checks "V3 ... exactly once, in rpi3_mon_acquire"', 'atomic_inc32 = ldaxr / add / stxr / b.ne loop; rpi3_mon_acquire contains bl atomic_inc32 (objcalls_monitor.txt)', 'PASS', "Instruction sequence read from the ON build; exclusivity on this memory type is a hardware property (W1, NOT RUN).")
r('V5', 'build system', 'scripts/build_optee_scratch.sh with PLATFORM=rpi3: final_off, final_on, final_on_debug', 'final_off.log / final_on.log / final_on_debug.log: exit 0, 0 warnings, 0 errors', 'PASS', "Scratch output directories, not the project's own out/arm build; stack checks passed explicitly (DEC-BUILD-1).")
r('V8', M+': all references; no reset command exists', 'static_checks "V3/V8"; inventory_probes_closure_20261107.txt (grep for reset: none; the one "= 0" hit is a local projection field)', ST, 'PASS', "The design's MON_RESET command does not exist in this implementation, so 'not reset by MON_RESET' holds vacuously.")
r('V13', M+': rpi3_mon_init', 'inventory_probes_closure_20261107.txt: one assignment to the mode member, in rpi3_mon_init', 'source grep on comment-stripped text', 'PASS', "Grep-level evidence; Mode D2 (Component 7) will add a second assignment by design.")
r('W5', M+': rpi3_mon_release, rpi3_mon_note_legacy, rpi3_mon_core1_attempt', 'static_checks "W5 unlocks only in release, note_legacy, core1_attempt; never in acquire" and "exactly 3 unlock call sites"', ST+'; negative control (unlock injected into acquire) failed the check', 'PASS', "Pattern check; also init writes SPINLOCK_UNLOCK before init_ok is published (design I2), which is not a force release at runtime.")
r('X8', M+', '+'rpi3_can_monitor_plat.h', 'static_checks "X8 no cpu_spin_lock / xsave / no_dldetect / expired() anywhere in the monitor sources"', ST, 'PASS', "Pattern check. The monitor's own helper rpi3_mon_expired exists and is used by evaluate, not by the acquire loop; the regex was fixed so it does not match that name.")
r('Y6', 'rpi3_can_server.c (monitor branch); '+M+': rpi3_mon_core1_entry_check', H+':492 "Y6/D1 the entry check panics unless FIQ and IRQ are both masked; the loop never changes the mask"; static_checks "D1 ... no ~THREAD_EXCP"', R+'; '+ST+'; mutant "Core 1 entry check inverted" caught', 'PASS', "The runtime assertion is tested with a mock mask register; on the board it has never executed.")
r('Y7', 'rpi3_can_server.c: #ifdef CFG_RPI3_CAN_MONITOR / #else', 'static_checks "Y7 the only FIQ unmask in rpi3_can_server.c is in the #else (non-Monitor) branch" and "F27/Y7 the legacy frame processing call is only in the #else branch"', ST+'; FINAL_DIFF.patch (server.c +22 -0)', 'PASS', "Source structure check; the compiled Monitor-ON image was not checked for the absence of the unmask instruction.")
r('Y8', M+': all uses of rpi3_mon.health.', 'static_checks "Y8/Z2 G7 words are accessed only through rpi3_mon_load/store_u32/u64 (outside init)"', ST, 'PASS', "Pattern check; accessors are always_inline __nostackcheck over __atomic builtins.")
r('Y9', 'rpi3_can_server.c: local mon_pass; rpi3_can_monitor.h: rpi3_mon_core1_pass', 'inventory_probes_closure_20261107.txt (mon_pass declared in the loop function); '+H+':468 (counter wraps from 0xFFFFFF00)', R, 'PASS', "Locality is by source inspection.")
r('H1', M+': rpi3_mon_frame_store (inlined into rpi3_mon_cmd17)', 'hold_memcpy_check.py -> hold_memcpy_h1fix_20261107.txt (control-flow analysis of every command in the rebuilt ON image); h1_objcheck_closure_20261107.txt; static_checks "H1 object code" (2 checks, ON_DIS set) in static_h1fix_20261107.txt; negative control h1_guard_negative_20261107.txt', 'FIRST RESULT 2026-11-07 (before the fix): FAIL. The compiled rpi3_mon_cmd17 contained a 44-byte memcpy (GCC turned the byte loop in rpi3_mon_frame_store into a call) between rpi3_mon_hold and rpi3_mon_release (hold_memcpy_closure_20261107.txt). FIX APPROVED AND APPLIED the same day: the destination pointer is volatile. After the fix, in the rebuilt hardened and debug ON images the only memcpy in cmd17 is the copy-in before the lock (outside any hold), cmd18 and cmd20 copy-outs are outside holds, both HMAC calls are outside holds, and the control-flow check exits 0. The guard fails on the pre-fix disassembly (negative control).', 'PASS', "Evidence is object code of the Monitor-ON and debug images built in scratch directories, not hardware. The check relies on a control-flow analysis of the disassembly (follows the success path after rpi3_mon_hold); it was validated by the pre-fix FAIL and the post-fix PASS. A future compiler or flag change can re-introduce the problem, which is why the guard was added to static_checks.sh (it needs ON_DIS and reports SKIPPED without it).")
r('H2', M+': all lock holds', 'static_checks "H2/CS1/CS2 critical-section helpers contain no memcpy/memset/heap/printing/crypto/lock calls"; hold_memcpy_closure_20261107.txt', ST+'; no rpi3_mon_hmac / crypto_* / trace_printf / malloc / free call inside any hold in cmd17..23, note_legacy, core1_attempt', 'PASS', "H2 as written covers CS1 (HMAC, allocation, printing, caller-memory copy) and CS2 (bounded). The memcpy-under-lock problem is CS3 and is recorded under H1.")
r('H4', M+': rpi3_mon_acquire, rpi3_mon_note_legacy, rpi3_mon_core1_attempt, rpi3_mon_cmd22', 'static_checks "G9 exactly three trylock call sites" and "G9 trylock only in acquire, note_legacy, core1_attempt"; objcalls_monitor.txt (cmd22: hold, release, then acquire, release)', ST, 'PASS', "Pattern and call-order evidence; no formal proof over all paths. cmd22 takes two sequential holds, never nested.")
r('H5', 'rpi3_can_monitor.h: _Static_assert Q2 and N5; '+M+': memcpy sites', 'inventory_probes_closure_20261107.txt (5 x 24 <= 128; proj0 and proj1 == 128); memcpy sizes 44 (cmd17), n x 24 <= 120 (cmd18), 128 (cmd20)', ST+' (compile-time guards present); build exit 0', 'PASS', "Review of the three memcpy sites plus compile-time asserts.")
r('Z2', M+': G7 words and pta_lock_timeouts', 'static_checks "Y8/Z2" and "V3/V8"', ST, 'PASS', "Pattern checks.")
r('Z7', 'tee.elf (ON): rpi3_can_server_loop call graph', 'callgraph.py -> callgraph_core1_f27.txt (72 reachable functions, forbidden: none); negative control: rpi3_mon_cmd17 reaches 6 forbidden symbols', 'callgraph_core1.txt: trace_printf reachable only via __do_panic <- rpi3_mon_core1_entry_check; legacy frame processing compiled out of the loop (static check F27/Y7)', 'PASS', "Direct calls only. Indirect calls (blr/br) exist in console_putc/console_flush/kprintf and are not resolved; the panic and trace path is reachable by design (terminal failure).")
# ---------------- on-board (9)
nb = "No hardware evidence exists. Needs the board, separate approval and the preconditions in BOARD_VALIDATION_READINESS.md."
r('V2', 'user-space atomic test on the Pi + host wrapper test', '-', '-', 'NOT RUN', nb+" The host stress tests use real threads on the host, which is not evidence for Normal-World memory on the Pi.")
r('V14', M+', '+G+': health pair on error returns', '-', 'Partial host evidence only: '+H+':443 "GLUE parameter mapping" shows the glue writes the value outputs for OK and BUSY', 'NOT RUN', nb+" What Linux's TEE driver actually delivers for a non-SUCCESS return is the question and is only answerable on the board.")
r('W1', 'lock memory attributes', '-', '-', 'NOT RUN', nb+" Static trace of the mapping was done earlier in design (4e); no runtime check.")
r('W2', 'boot order: driver_init before Core 1 diverted', '-', '-', 'NOT RUN', nb+" No UART, so the boot log inside Secure World cannot be read; the order was reasoned from the source only.")
r('W4', G+': WAKE_CORE1 (13) refused', '-', 'Partial host evidence for the refusal half: '+H+':417 "LG1/LG4 refused ids 0,3,6,7,13,14" (see R). The ALREADY_ON half applies to the legacy, non-Monitor path.', 'NOT RUN', nb+" Superseded in part by the interface decisions: the Monitor profile refuses command 13 in both profiles.")
r('W7', 'forced Core 1 panic', '-', '-', 'NOT RUN', "Needs its own separate approval; no UART and no spare SD card. Never run.")
r('X9', 'measured wait with a simulated holder', '-', '-', 'NOT RUN', nb)
r('Y10', 'Core 1 pass duration, collision rate, hold time', '-', '-', 'NOT RUN', nb+" The 2.435 us per pass and 1.6 percent figures in the design are earlier inferences.")
r('H3', 'worst-case and p99 lock-hold time (CS5)', '-', '-', 'NOT RUN', nb+" Hold time in microseconds is PENDING hardware measurement; no number is claimed anywhere.")
# ---------------- deferred (1)
r('Z8', G+': rpi3_mon_pta_invoke legacy policy', H+':417 "LG1/LG4 refused ids 0,3,6,7,13,14"; :422 "LG2 chip A debug readers: refused when hardened; allowed with an event in the debug profile"; :426 "LG3"', R+'; mutants "WRITE_REG32 no longer refused", "hardened profile allows the debug readers", "commands 12 refused", "legacy refusal logs nothing" caught', 'PASS', HOSTLIM+" The original row names 4, 6, 7, 14, 15, 16; the implemented policy (decisions DEC-IF-8 to 10) refuses 6, 7, 14 always and 4, 15, 16 in the hardened profile, logging them in the debug profile. Debug profile built (final_on_debug) but behaviour tested only through the mock flag.")
assert list(orig) and set(rows) == set(orig), (set(orig) ^ set(rows))
cnt = collections.Counter(v[3] for v in rows.values())
out = []
out.append("# COMPONENT_2_2_INVENTORY.md - evidence mapping of the original 53 checks\n")
out.append("Date: 2026-11-07 (regenerated after the H1 fix). Generated by `source_tests/make_inventory.py`: the 53 IDs, requirement texts and kinds are parsed from the original table in `MONITOR_STATE_DESIGN.md` section 4j (nothing renamed, nothing deleted). The evidence column is hand-written and every cited file exists in `Part_E_Verification/`.\n")
out.append("Result vocabulary: **PASS** = the requirement as written was verified by the cited real evidence; **FAIL** = a real defect was found; **NOT RUN** = needs the board or was not executed; **NOT VERIFIED** = evidence insufficient (none in this list). Evidence classes: HOST = real monitor source compiled for the host with a mock platform (not hardware); STATIC = pattern check on comment-stripped source; OBJECT = inspection of the compiled Monitor-ON `tee.elf`; BUILD = OP-TEE scratch build.\n")
out.append("**Evidence vintage.** Rows cite the `*_closure_20261107.txt` logs, produced before the H1 fix. The fix changed only `rpi3_mon_frame_store` (3 lines added, 1 removed). All suites were rerun on the fixed source with identical results: `run_h1fix_20261107.txt` (406 checks, 0 failed), `static_h1fix_20261107.txt` (55 pass including the 2 new object-code checks), `mutation_h1fix_20261107.txt` (137 of 140, the same 3 equivalent survivors), rebuilt OFF/ON/debug images (`build_scratch/final_*_h1.log`, 0 warnings).\n")
out.append("## Summary\n")
out.append("| Result | Rows |\n|---|---|")
for k in ('PASS', 'FAIL', 'NOT RUN', 'NOT VERIFIED'): out.append("| %s | %d |" % (k, cnt.get(k, 0)))
out.append("| **Total** | **%d** |\n" % sum(cnt.values()))
kinds = collections.Counter((orig[i][1], rows[i][3]) for i in orig)
out.append("| Kind (original) | PASS | FAIL | NOT RUN |\n|---|---|---|---|")
for k in ('host-side logic test', 'static / review / build / disassembly', 'on-board', 'deferred to interface subcomponent'):
    out.append("| %s | %d | %d | %d |" % (k, kinds[(k, 'PASS')], kinds[(k, 'FAIL')], kinds[(k, 'NOT RUN')]))
out.append("\n**Nothing here is hardware evidence.** All 9 on-board rows are NOT RUN. H1 first FAILED on 2026-11-07 (a real object-code finding, not a test artifact); the fix was approved and applied the same day and the row is PASS after re-inspection of the rebuilt images.\n")
out.append("## The 53 original checks versus the 53 static checks\n")
out.append("These are two unrelated sets that happen to have the same size. The original 53 are the design's check inventory (section 4j; IDs such as V6, X3, Y7, H1). The 53 in `static_checks.sh` are pattern checks written during implementation (build guards, lock-site counts, boundaries with the pre-change snapshots, key hygiene) and cover only part of the 18 static rows plus checks that have no original ID (BG*, BOUNDARY*, KEY*, PTA*, DEC-IF*). A pass of 53/53 there is therefore **not** a pass of the original 53; each original row below cites its own evidence.\n")
out.append("## Duplicates, overlaps and superseded rows (kept, not deleted)\n")
out.append("- **Overlap:** Z4 repeats X7 (same BUSY property, one test serves both); Z2 repeats Y8 plus the counter part of V3/V8; V12 and Z5 share the exactly-once test; X1 shares its test with V7 and X2 with X6 and V6; Y3, Y4, Y5 share one test.\n- **Split pair:** Y6 (IRQ) and Y7 (FIQ) are the two halves of decision D1. Y7's wording was already updated for D1 Option B on 2026-11-07.\n- **Partly superseded by decisions:** W4 (Monitor profile refuses command 13; the ALREADY_ON half applies only to the legacy path) and Z8 (the policy implemented is DEC-IF-8 to 10, which differs in detail from the row's list).\n- **Vacuous by construction:** V8's 'MON_RESET' clause (no such command exists in the implementation).\n- **Not in the 53:** the 86 interface and implementation checks added later (N*, K*, HP*, Q*, EV*, C17-*, ...) remain in the design document with their own status and are **not mapped here**.\n")
out.append("## Mapping\n")
out.append("Paths: source files are under `optee_full/optee_os/core/arch/arm/plat-rpi3/` (`rpi3_can_monitor.c`) and `core/pta/` (`rpi3_can_monitor_pta.c`); tests and logs are under `Part_E_Verification/monitor/source_tests/`; build logs under `Part_E_Verification/build_scratch/`. `harness.c:NNN` is the line of the `begin(\"...\")` title.\n")
out.append("| Check ID | Requirement (original text) | Source location | Test or static check | Evidence | Result | Limitation |\n|---|---|---|---|---|---|---|")
for i, (req, kind) in orig.items():
    loc, test, ev, res, lim = rows[i]
    esc = lambda x: x.replace('|', '\\|')
    out.append("| %s | %s | %s | %s | %s | **%s** | %s |" % (i, esc(req), esc(loc), esc(test), esc(ev), res, esc(lim)))
open('../COMPONENT_2_2_INVENTORY.md', 'w').write("\n".join(out) + "\n")
print(dict(cnt), "rows:", len(rows))
