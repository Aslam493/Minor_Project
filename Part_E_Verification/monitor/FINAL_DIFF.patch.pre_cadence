+ */
+#define RPI3_CAN_SPI_POC_PTA_FLAGS PTA_DEFAULT_FLAGS
+#ifdef CFG_RPI3_CAN_MONITOR
+_Static_assert(!(RPI3_CAN_SPI_POC_PTA_FLAGS & TA_FLAG_CONCURRENT),
