@@ -249,4 +249,24 @@
  */
 #define PTA_RPI3_CAN_SPI_POC_CMD_GET_TIMESTAMP_DEBUG 16
 
+/*
+ * Secure CAN Monitor commands (Component 2.2). Only dispatched when the OP-TEE build has CFG_RPI3_CAN_MONITOR=y;
+ * otherwise these ids behave as unknown commands. Slots 2 and 3 are VALUE_OUTPUT in every monitor command and
+ * carry the health pair. Full contracts: Part_E_Verification/monitor/MONITOR_STATE_DESIGN.md, section 4k.
+ *   17 SUBMIT_FRAME     p0 VALUE_OUTPUT (a verdict, b detail), p1 MEMREF_INPUT (44-byte frame)
+ *   18 GET_EVENTS       p0 VALUE_INOUT (in a first seq, in b max entries 1..5; out a count|more<<8, out b ev_lost), p1 MEMREF_OUTPUT
+ *   19 ACK_EVENTS       p0 VALUE_INOUT (in a ack up to seq, in b 0; out a 0, out b effective ev_ack)
+ *   20 GET_STATUS       p0 VALUE_INOUT (in a page 0 or 1, in b 0; out a 128, out b layout version), p1 MEMREF_OUTPUT (>= 128)
+ *   21 SET_IDLE         p0 VALUE_INOUT (in a mode 0|1, in b ms; out a verdict, out b remaining ms)
+ *   22 GET_NONCE        p0 VALUE_OUTPUT (nonce lo, hi), p1 VALUE_OUTPUT (hb_seq, hb_state)
+ *   23 SUBMIT_HB_ANSWER p0 VALUE_INOUT (in a hb_seq, in b 0; out a verdict, out b detail), p1 VALUE_INPUT (nonce lo, hi)
+ */
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_SUBMIT_FRAME 17
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_GET_EVENTS 18
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_ACK_EVENTS 19
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_GET_STATUS 20
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_SET_IDLE 21
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_GET_NONCE 22
+#define PTA_RPI3_CAN_SPI_POC_CMD_MON_SUBMIT_HB_ANSWER 23
+
 #endif /* __PTA_RPI3_CAN_SPI_POC_H__ */
--- a/core/arch/arm/plat-rpi3/rpi3_can_server.c
+++ b/core/arch/arm/plat-rpi3/rpi3_can_server.c
@@ -52,6 +52,9 @@
 #include <trace.h>
 
 #include "platform_config.h"
+#ifdef CFG_RPI3_CAN_MONITOR
+#include <rpi3_can_monitor.h>
+#endif
 
 struct rpi3_can_server_result;
 
@@ -392,11 +395,30 @@
  */
 void __noreturn rpi3_can_server_loop(void)
 {
+#ifdef CFG_RPI3_CAN_MONITOR
+	/*
+	 * Secure CAN Monitor build, decision D1 = Option B (design 4g C7): FIQ and IRQ stay masked for the WHOLE loop.
+	 * CPU_ON left every exception masked and nothing here unmasks any of them, so no FIQ can ever be taken on top
+	 * of the live loop frames (the O-01 stack overlap cannot occur). The legacy chip A frame path, which reaches
+	 * HMAC and the heap, is not run in this build (F27: Core 1 never calls HMAC or the shared heap).
+	 */
+	uint32_t mon_pass = 0;
+	bool mon_on;
+
+	rpi3_mon_core1_entry_check();		/* panics if FIQ or IRQ is unmasked */
+	mon_on = rpi3_mon_init_ok();		/* a failed monitor init leaves Core 1 doing nothing but the heartbeat */
+#else
 	thread_set_exceptions(thread_get_exceptions() & ~THREAD_EXCP_NATIVE_INTR);
+#endif
 
 	while (true) {
 		rpi3_can_server_heartbeat++;
+#ifdef CFG_RPI3_CAN_MONITOR
+		if (mon_on)
+			rpi3_mon_core1_pass(mon_pass++);	/* G7 update inline; one lock attempt per 256 passes */
+#else
 		rpi3_can_fiq_process_pending_frame();
+#endif
 		dsb();
 	}
 }
--- a/core/arch/arm/plat-rpi3/conf.mk
+++ b/core/arch/arm/plat-rpi3/conf.mk
@@ -24,6 +24,24 @@
 # directly over real SPI0, independent of Linux's own drivers.
 CFG_RPI3_CAN_SPI_POC_PTA ?= y
 
+# Secure CAN Monitor (Component 2): OFF by default, so a default build is unchanged. It needs the PTA above.
+# CFG_RPI3_CAN_MONITOR_DEBUG (default n, build time only) selects the debug profile of the legacy-command policy.
+CFG_RPI3_CAN_MONITOR ?= n
+CFG_RPI3_CAN_MONITOR_DEBUG ?= n
+# CFG_RPI3_CAN_MONITOR_TEST_STATS (default n): TEST BUILDS ONLY. Adds lock-hold-time stamps, Core 1 attempt-interval statistics, a Core 1 lock-hold
+# request (check X9) and two test-only PTA commands (24 read, 25 control). Never use it for a release image.
+CFG_RPI3_CAN_MONITOR_TEST_STATS ?= n
+ifeq ($(CFG_RPI3_CAN_MONITOR_TEST_STATS),y)
+ifneq ($(CFG_RPI3_CAN_MONITOR),y)
+$(error CFG_RPI3_CAN_MONITOR_TEST_STATS=y requires CFG_RPI3_CAN_MONITOR=y)
+endif
+endif
+ifeq ($(CFG_RPI3_CAN_MONITOR),y)
+ifneq ($(CFG_RPI3_CAN_SPI_POC_PTA),y)
+$(error CFG_RPI3_CAN_MONITOR=y requires CFG_RPI3_CAN_SPI_POC_PTA=y)
+endif
+endif
+
 arm32-platform-cflags += -Wno-error=cast-align
 arm64-platform-cflags += -Wno-error=cast-align
 
